				<key>script</key>
				<string>command="${wordping_command:-$1}"
case "$command" in
  ~remind:*) result=$(/bin/sh ./scripts/reminders.sh "$command" 2&gt;&amp;1) ;;
  *) result=$(./runtime/tjs run ./index.js "$command") ;;
esac
printf '%s\n' "$result"
return_to=""
case "$command" in
  ~remember:*|~again:*)
    return_to="${wordping_return:-review}"
    ;;
  ~next:review)
    return_to="review"
    ;;
  ~next:reverse)
    return_to="reverse"
    ;;
  ~remove:*)
    return_to="${wordping_return:-}"
    ;;
esac
case "$return_to" in
  review)
    /usr/bin/osascript -e 'tell application id "com.runningwithcrayons.Alfred" to search "wp :review"' &gt;/dev/null
    ;;
  reverse)
    /usr/bin/osascript -e 'tell application id "com.runningwithcrayons.Alfred" to search "wp :reverse"' &gt;/dev/null
    ;;
  saved)
    /usr/bin/osascript -e 'tell application id "com.runningwithcrayons.Alfred" to search "wp :saved"' &gt;/dev/null
    ;;
esac</string>
